[global]
ioengine=libaio
direct=1
thread=1
group_reporting=1
size=512m
filename=testfile.dat
random_generator=tausworthe64
random_distribution=random
randrepeat=0
rate_iops=0

[SEQ1M-Q8T1-Read]
rw=read
bs=1m
iodepth=8
numjobs=1
gtod_reduce=1
stonewall

[SEQ1M-Q8T1-Write]
rw=write
bs=1m
iodepth=8
numjobs=1
gtod_reduce=1
stonewall

[RND4K-Q32T16-Read]
rw=randread
bs=4k
iodepth=32
numjobs=16
gtod_reduce=1
stonewall

[RND4K-Q32T16-Write]
rw=randwrite
bs=4k
iodepth=32
numjobs=16
gtod_reduce=1
stonewall

[RND4K-Q1T1-Read]
rw=randread
bs=4k
iodepth=1
numjobs=1
gtod_reduce=1
stonewall

[RND4K-Q1T1-Write]
rw=randwrite
bs=4k
iodepth=1
numjobs=1
gtod_reduce=1
stonewall

[RND4K-Q1T1-Lat-Read]
rw=randread
bs=4k
iodepth=1
numjobs=1
stonewall
time_based=1
runtime=10

[RND4K-Q1T1-Lat-Write]
rw=randwrite
bs=4k
iodepth=1
numjobs=1
stonewall
time_based=1
runtime=10
